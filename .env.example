# TranscritorLES - Environment Variables
# Copie este arquivo para .env.local e ajuste conforme necessário

# Nome da aplicação (exibido na UI)
NEXT_PUBLIC_APP_NAME=TranscritorLES

# Modelo padrão ao carregar (opções: Xenova/whisper-tiny, Xenova/whisper-base, Xenova/whisper-small)
NEXT_PUBLIC_DEFAULT_MODEL=Xenova/whisper-tiny

# Tamanho máximo de arquivo em MB
NEXT_PUBLIC_MAX_FILE_SIZE_MB=500

# Habilitar logs de debug no console
NEXT_PUBLIC_DEBUG=false

# URL base para assets (útil para CDN)
# NEXT_PUBLIC_ASSET_PREFIX=https://cdn.seudominio.com